{
  "name": "court-reportcard",
  "version": "1.0.0",
  "description": "Lexicon Precision - Court Transcript Editorial Tool",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:seo": "node scripts/sync-seo.mjs",
    "check:seo": "node scripts/sync-seo.mjs --check",
    "build": "node scripts/sync-seo.mjs && vite build",
    "preview": "vite preview",
    "test:export": "node scripts/test-export-integrity.mjs",
    "test:parse-json": "node scripts/test-parse-gemini-json.mjs",
    "test:highlight-jump": "node scripts/test-highlight-jump-coverage.mjs",
    "test:rtf-upload": "node scripts/test-rtf-upload-path.mjs",
    "seed:export-mock": "node scripts/seed-export-mock-case.mjs",
    "seed:sample-transcript": "node scripts/seed-sample-transcript-case.mjs",
    "seed:jump-highlight": "node scripts/seed-jump-highlight-case.mjs",
    "seed:extra-word-delete": "node scripts/seed-extra-word-delete-case.mjs",
    "seed:extra-word-glue": "node scripts/seed-extra-word-glue-case.mjs",
    "seed:repeated-paragraph": "node scripts/seed-repeated-paragraph-case.mjs",
    "seed:export-verify-fail": "node scripts/seed-export-verify-fail-case.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.2",
    "vite": "^4.4.5"
  }
}
